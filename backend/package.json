{
  "name": "eventsphere-backend",
  "version": "1.0.0",
  "description": "EventSphere Management - REST API (Node.js, Express, MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "backup": "node src/scripts/backup.js",
    "restore": "node src/scripts/restore.js",
    "test:email": "node src/scripts/test-email.js",
    "test": "node --test --test-concurrency=1 tests/auth.test.js tests/workflow.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bson": "^7.3.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
