NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

mongo_uri=mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/EventSphere_management?ssl=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority
# or: mongodb+srv://<user>:<password>@<cluster>/EventSphere_management

# Auth secrets (change in production; min 32 chars)
JWT_ACCESS_SECRET=replace_with_a_random_string_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_another_random_string_of_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Organizer self-registration is gated by this invite code
ORGANIZER_INVITE_CODE=choose-a-secret-code

# Optional SMTP (if empty, emails are logged to the console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EventSphere <no-reply@eventsphere.local>"

# Cloudinary (image/PDF uploads). If empty, files are stored on local disk in /uploads
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
