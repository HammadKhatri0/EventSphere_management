{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://eventsphere-management.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://eventsphere-management.onrender.com/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
